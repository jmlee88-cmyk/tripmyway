{
  // tripmyway-fulfil: paid Shopify orders → print files → ArtBeat. See fulfil/README.md.
  "name": "tripmyway-fulfil",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // "manual": make print files and wait on the orders page for someone to order
    // on ArtBeat by hand. "api": send orders to ArtBeat's partner API automatically.
    "FULFIL_MODE": "manual",
    // Default print file: "front" (the printed face only; ArtBeat adds bleed and
    // canvas edge) or "edge" (file includes bleed / 1.5" mirrored canvas edge).
    // Each order can be remade the other way from the orders page.
    "PRINT_EDGE": "front",
    "SHOPIFY_ADMIN_URL": "https://admin.shopify.com/store/tripmyway-bf2kmucg",
    "TIME_ZONE": "America/Los_Angeles",
    // API mode only: "dev" until ArtBeat's live API is confirmed; then "live".
    "ARTBEAT_ENV": "dev",
    // Where print file links point (admin.tripmyway.com is attached to this Worker).
    "PUBLIC_URL": "https://admin.tripmyway.com",
    "SUBMIT_TEST_ORDERS": "false"
  },
  // Print converter (Node + Poppler + libvips). Built from the repo root so it
  // can bundle the site's own print renderer and fonts.
  "containers": [
    {
      "class_name": "PrintConverter",
      "image": "./container/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONVERTER", "class_name": "PrintConverter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrintConverter"] }],
  "queues": {
    "producers": [{ "binding": "ORDERS", "queue": "tripmyway-orders" }],
    "consumers": [
      { "queue": "tripmyway-orders", "max_batch_size": 1, "max_retries": 6, "max_concurrency": 2 }
    ]
  },
  // Order records and print files (a lifecycle rule deletes files after 14 days).
  "r2_buckets": [{ "binding": "PRINTFILES", "bucket_name": "tripmyway-printfiles" }]
}
